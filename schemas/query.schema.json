{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "default": "2.0"
    },
    "authority": {
      "anyOf": [
        {
          "$ref": "#/$defs/Authority"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "filter": {
      "$ref": "#/$defs/RoleFilter",
      "default": {
        "functions": [],
        "max_level": null,
        "min_importance": null,
        "scopes": [],
        "text": ""
      }
    },
    "locale": {
      "type": "string",
      "default": "fr"
    },
    "members": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "default": null,
      "minimum": 0
    },
    "size": {
      "$ref": "#/$defs/Size",
      "default": "full"
    },
    "structure": {
      "anyOf": [
        {
          "$ref": "#/$defs/Structure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "system": {
      "type": "string"
    },
    "theme": {
      "type": "string",
      "default": "generic"
    }
  },
  "additionalProperties": false,
  "required": [
    "system"
  ],
  "$defs": {
    "Authority": {
      "type": "string",
      "enum": [
        "hereditary",
        "aristocratic",
        "authoritarian",
        "democratic",
        "theocratic",
        "military",
        "bureaucratic",
        "meritocratic",
        "consensual",
        "personal"
      ]
    },
    "RoleFilter": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "max_level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "min_importance": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Size": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "large",
        "vast",
        "full"
      ]
    },
    "Structure": {
      "type": "string",
      "enum": [
        "hierarchical",
        "horizontal",
        "network",
        "cellular"
      ]
    }
  }
}
