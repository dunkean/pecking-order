{
  "openapi": "3.1.0",
  "info": {
    "title": "Pecking Order",
    "version": "1.0",
    "description": "Bilingual institutional blueprints and culture-scoped titles."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8773"
    }
  ],
  "paths": {
    "/api/resolve": {
      "post": {
        "operationId": "resolveInstitution",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Query"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolution including explicit semantic status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resolution"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or request schema"
          },
          "403": {
            "description": "Foreign origin"
          },
          "413": {
            "description": "Invalid body size; maximum 32768 bytes"
          },
          "415": {
            "description": "Content-Type application/json required"
          }
        }
      }
    },
    "/api/catalog": {
      "get": {
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Template and culture summaries, compatibility and coverage."
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "operationId": "getSources",
        "responses": {
          "200": {
            "description": "All source metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Source"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Adaptation": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "authoritarian",
              "elective_succession",
              "hereditary_succession"
            ],
            "title": "Kind",
            "type": "string"
          },
          "target_role": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Target Role",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "target_role"
        ],
        "title": "Adaptation",
        "type": "object"
      },
      "Organization": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Kind",
            "type": "string"
          },
          "scale": {
            "enum": [
              "household",
              "local",
              "district",
              "regional",
              "polity",
              "imperial",
              "transregional"
            ],
            "title": "Scale",
            "type": "string"
          },
          "traits": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "maxItems": 20,
            "title": "Traits",
            "type": "array"
          }
        },
        "required": [
          "kind",
          "scale"
        ],
        "title": "Organization",
        "type": "object"
      },
      "Query": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "culture": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Culture",
            "type": "string"
          },
          "organization": {
            "$ref": "#/components/schemas/Organization"
          },
          "role": {
            "anyOf": [
              {
                "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role"
          },
          "as_of": {
            "anyOf": [
              {
                "maximum": 10000,
                "minimum": -10000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "As Of"
          },
          "mode": {
            "default": "historical",
            "enum": [
              "historical",
              "inspired",
              "generic"
            ],
            "title": "Mode",
            "type": "string"
          },
          "locale": {
            "default": "fr",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "title": "Locale",
            "type": "string"
          },
          "fallback_locale": {
            "default": "en",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "title": "Fallback Locale",
            "type": "string"
          },
          "adaptations": {
            "items": {
              "$ref": "#/components/schemas/Adaptation"
            },
            "maxItems": 8,
            "title": "Adaptations",
            "type": "array"
          }
        },
        "required": [
          "culture",
          "organization"
        ],
        "title": "Query",
        "type": "object"
      },
      "Blueprint": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "domain": {
            "enum": [
              "political",
              "administrative",
              "military",
              "religious",
              "economic",
              "kinship",
              "judicial",
              "educational",
              "civic",
              "clandestine",
              "diplomatic",
              "fantastic"
            ],
            "title": "Domain",
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/Localized"
          },
          "description": {
            "$ref": "#/components/schemas/Localized"
          },
          "scales": {
            "items": {
              "enum": [
                "household",
                "local",
                "district",
                "regional",
                "polity",
                "imperial",
                "transregional"
              ],
              "type": "string"
            },
            "minItems": 1,
            "title": "Scales",
            "type": "array"
          },
          "traits": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "title": "Traits",
            "type": "array"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "minItems": 1,
            "title": "Roles",
            "type": "array"
          },
          "relations": {
            "items": {
              "$ref": "#/components/schemas/Relation"
            },
            "title": "Relations",
            "type": "array"
          },
          "units": {
            "items": {
              "$ref": "#/components/schemas/Unit"
            },
            "title": "Units",
            "type": "array"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "title": "Rules",
            "type": "array"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          }
        },
        "required": [
          "id",
          "domain",
          "label",
          "description",
          "scales",
          "traits",
          "roles",
          "relations",
          "units",
          "rules",
          "evidence"
        ],
        "title": "Blueprint",
        "type": "object"
      },
      "Candidate": {
        "additionalProperties": false,
        "properties": {
          "culture": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Culture",
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/Localized"
          },
          "period": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Period",
            "type": "array"
          },
          "supported_kinds": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "title": "Supported Kinds",
            "type": "array"
          }
        },
        "required": [
          "culture",
          "label",
          "period",
          "supported_kinds"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "CultureContext": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/Localized"
          },
          "region": {
            "$ref": "#/components/schemas/Localized"
          },
          "period": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Period",
            "type": "array"
          },
          "description": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "required": [
          "id",
          "label",
          "region",
          "period",
          "description"
        ],
        "title": "CultureContext",
        "type": "object"
      },
      "Diagnostic": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "$ref": "#/components/schemas/Localized"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "title": "Fields",
            "type": "array"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "Diagnostic",
        "type": "object"
      },
      "EvidenceRef": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "default": "generic_model",
            "enum": [
              "generic_model",
              "source_supported",
              "adapted"
            ],
            "title": "Status",
            "type": "string"
          },
          "sources": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "note": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "required": [
          "note"
        ],
        "title": "EvidenceRef",
        "type": "object"
      },
      "Localized": {
        "additionalProperties": false,
        "description": "All authored text needs both launch languages; additional languages are welcome.",
        "properties": {
          "labels": {
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          }
        },
        "required": [
          "labels"
        ],
        "title": "Localized",
        "type": "object"
      },
      "Power": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Action",
            "type": "string"
          },
          "domain": {
            "enum": [
              "political",
              "administrative",
              "military",
              "religious",
              "economic",
              "kinship",
              "judicial",
              "educational",
              "civic",
              "clandestine",
              "diplomatic",
              "fantastic"
            ],
            "title": "Domain",
            "type": "string"
          },
          "basis": {
            "enum": [
              "de_jure",
              "de_facto",
              "ritual",
              "advisory"
            ],
            "title": "Basis",
            "type": "string"
          },
          "scope": {
            "$ref": "#/components/schemas/Localized"
          },
          "limits": {
            "$ref": "#/components/schemas/Localized"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          }
        },
        "required": [
          "action",
          "domain",
          "basis",
          "scope",
          "limits",
          "evidence"
        ],
        "title": "Power",
        "type": "object"
      },
      "Relation": {
        "additionalProperties": false,
        "properties": {
          "source": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Target",
            "type": "string"
          },
          "kind": {
            "enum": [
              "reports_to",
              "advises",
              "appoints",
              "removes",
              "elects",
              "checks",
              "represents",
              "member_of",
              "coordinates",
              "ritually_legitimizes"
            ],
            "title": "Kind",
            "type": "string"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          }
        },
        "required": [
          "source",
          "target",
          "kind",
          "evidence"
        ],
        "title": "Relation",
        "type": "object"
      },
      "Role": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "function": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Function",
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/Localized"
          },
          "title": {
            "$ref": "#/components/schemas/Title"
          },
          "holder": {
            "default": "person",
            "enum": [
              "person",
              "collective"
            ],
            "title": "Holder",
            "type": "string"
          },
          "min_holders": {
            "default": 0,
            "minimum": 0,
            "title": "Min Holders",
            "type": "integer"
          },
          "max_holders": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": 1,
            "title": "Max Holders"
          },
          "duties": {
            "$ref": "#/components/schemas/Localized"
          },
          "powers": {
            "items": {
              "$ref": "#/components/schemas/Power"
            },
            "title": "Powers",
            "type": "array"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "title": "Rules",
            "type": "array"
          },
          "title_evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          },
          "rank": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Title"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "id",
          "function",
          "label",
          "title",
          "duties",
          "powers",
          "rules",
          "title_evidence"
        ],
        "title": "Role",
        "type": "object"
      },
      "Rule": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "category": {
            "enum": [
              "selection",
              "succession",
              "tenure",
              "removal",
              "eligibility",
              "membership",
              "inheritance",
              "residence",
              "marriage",
              "decision",
              "incompatibility",
              "vacancy"
            ],
            "title": "Category",
            "type": "string"
          },
          "method": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Method",
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/Localized"
          },
          "parameters": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "title": "Parameters",
            "type": "object"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceRef"
          }
        },
        "required": [
          "id",
          "category",
          "method",
          "description",
          "evidence"
        ],
        "title": "Rule",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "publisher": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Publisher",
            "type": "string"
          },
          "url": {
            "pattern": "^https://",
            "title": "Url",
            "type": "string"
          },
          "accessed": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Accessed",
            "type": "string"
          },
          "locator": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Locator",
            "type": "string"
          },
          "supports": {
            "$ref": "#/components/schemas/Localized"
          },
          "limitations": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessed",
          "locator",
          "supports",
          "limitations"
        ],
        "title": "Source",
        "type": "object"
      },
      "Title": {
        "additionalProperties": false,
        "properties": {
          "labels": {
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              }
            },
            "title": "Labels",
            "type": "object"
          },
          "native": {
            "anyOf": [
              {
                "maxLength": 4000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Native"
          },
          "language": {
            "anyOf": [
              {
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          },
          "forms": {
            "patternProperties": {
              "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$": {
                "additionalProperties": {
                  "maxLength": 4000,
                  "minLength": 1,
                  "type": "string"
                },
                "type": "object"
              }
            },
            "title": "Forms",
            "type": "object"
          },
          "translation": {
            "default": "equivalent",
            "enum": [
              "equivalent",
              "gloss",
              "loanword"
            ],
            "title": "Translation",
            "type": "string"
          }
        },
        "required": [
          "labels"
        ],
        "title": "Title",
        "type": "object"
      },
      "Unit": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
            "title": "Kind",
            "type": "string"
          },
          "relation": {
            "enum": [
              "contains",
              "federates",
              "oversees",
              "affiliates"
            ],
            "title": "Relation",
            "type": "string"
          },
          "min_count": {
            "default": 0,
            "minimum": 0,
            "title": "Min Count",
            "type": "integer"
          },
          "max_count": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Max Count"
          },
          "note": {
            "$ref": "#/components/schemas/Localized"
          }
        },
        "required": [
          "kind",
          "relation",
          "note"
        ],
        "title": "Unit",
        "type": "object"
      },
      "Resolution": {
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "kb_version": {
            "title": "Kb Version",
            "type": "string"
          },
          "kb_digest": {
            "title": "Kb Digest",
            "type": "string"
          },
          "request": {
            "$ref": "#/components/schemas/Query"
          },
          "status": {
            "enum": [
              "resolved",
              "needs_context",
              "unsupported",
              "conflict",
              "role_not_found"
            ],
            "title": "Status",
            "type": "string"
          },
          "culture": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CultureContext"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "blueprint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Blueprint"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "selected_roles": {
            "items": {
              "pattern": "^[a-z][a-z0-9_.-]{0,95}$",
              "type": "string"
            },
            "title": "Selected Roles",
            "type": "array"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "title": "Candidates",
            "type": "array"
          },
          "diagnostics": {
            "items": {
              "$ref": "#/components/schemas/Diagnostic"
            },
            "title": "Diagnostics",
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "title": "Sources",
            "type": "array"
          },
          "translation_fallbacks": {
            "items": {
              "type": "string"
            },
            "title": "Translation Fallbacks",
            "type": "array"
          },
          "display": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Display",
            "type": "object"
          }
        },
        "required": [
          "kb_version",
          "kb_digest",
          "request",
          "status"
        ],
        "title": "Resolution",
        "type": "object"
      },
      "Binding": {
        "additionalProperties": false,
        "properties": {
          "template": {
