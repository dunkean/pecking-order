{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string"
    },
    "authority": {
      "$ref": "#/$defs/Authority"
    },
    "available_role_count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "content_version": {
      "type": "string"
    },
    "description": {
      "$ref": "#/$defs/Text"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Text"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RelatedSystem"
      }
    },
    "request": {
      "$ref": "#/$defs/Query"
    },
    "roles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Role"
      }
    },
    "size": {
      "$ref": "#/$defs/Size"
    },
    "structure": {
      "$ref": "#/$defs/Structure"
    },
    "system": {
      "$ref": "#/$defs/RelatedSystem"
    },
    "theme": {
      "$ref": "#/$defs/RelatedSystem"
    }
  },
  "required": [
    "api_version",
    "content_version",
    "request",
    "system",
    "theme",
    "description",
    "size",
    "structure",
    "authority",
    "roles",
    "available_role_count",
    "related",
    "notes"
  ],
  "$defs": {
    "Authority": {
      "type": "string",
      "enum": [
        "hereditary",
        "aristocratic",
        "authoritarian",
        "democratic",
        "theocratic",
        "military",
        "bureaucratic",
        "meritocratic",
        "consensual",
        "personal"
      ]
    },
    "Power": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "Query": {
      "type": "object",
      "properties": {
        "api_version": {
          "type": "string",
          "default": "2.0"
        },
        "authority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Authority"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "filter": {
          "$ref": "#/$defs/RoleFilter",
          "default": {
            "functions": [],
            "max_level": null,
            "min_importance": null,
            "scopes": [],
            "text": ""
          }
        },
        "locale": {
          "type": "string",
          "default": "fr"
        },
        "members": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "size": {
          "$ref": "#/$defs/Size",
          "default": "full"
        },
        "structure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Structure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "system": {
          "type": "string"
        },
        "theme": {
          "type": "string",
          "default": "generic"
        }
      },
      "additionalProperties": false,
      "required": [
        "system"
      ]
    },
    "RelatedSystem": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "Role": {
      "type": "object",
      "properties": {
        "collective": {
          "type": "boolean"
        },
        "display_duties": {
          "type": "string"
        },
        "display_title": {
          "type": "string"
        },
        "duties": {
          "$ref": "#/$defs/Text"
        },
        "function": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "importance": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "optional": {
          "type": "boolean"
        },
        "powers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Power"
          }
        },
        "reports_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/Text"
        },
        "title": {
          "$ref": "#/$defs/Title"
        },
        "title_key": {
          "type": "string"
        },
        "title_theme": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "function",
        "title_key",
        "title",
        "display_title",
        "level",
        "importance",
        "scope",
        "reports_to",
        "duties",
        "display_duties",
        "powers",
        "collective",
        "optional",
        "selection",
        "title_theme"
      ]
    },
    "RoleFilter": {
      "type": "object",
      "properties": {
        "functions": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "max_level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "min_importance": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "default": null,
          "maximum": 255,
          "minimum": 0
        },
        "scopes": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "Size": {
      "type": "string",
      "enum": [
        "tiny",
        "small",
        "medium",
        "large",
        "vast",
        "full"
      ]
    },
    "Structure": {
      "type": "string",
      "enum": [
        "hierarchical",
        "horizontal",
        "network",
        "cellular"
      ]
    },
    "Text": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "fr",
        "en"
      ]
    },
    "Title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "native": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "variants": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TitleVariant"
          }
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "fr",
        "en"
      ]
    },
    "TitleVariant": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "native": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "qualifier": {
          "type": "string",
          "default": ""
        }
      },
      "required": [
        "fr",
        "en"
      ]
    }
  }
}
